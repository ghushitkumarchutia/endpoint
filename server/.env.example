# ==============================================================================
# 🚀 ENDPOINT - SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================
# This is a template file. DO NOT place your actual secrets here!
# 
# Instructions:
# 1. Duplicate this file in the `server` directory and rename it to `.env`
#    (Command: `cp .env.example .env`)
# 2. Replace the placeholder values below with your actual credentials.
# 
# WARNING: NEVER COMMIT ACTUAL .env FILES TO VERSION CONTROL!
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 SERVER CONFIGURATION
# ------------------------------------------------------------------------------

# The port your backend server will listen on. Default is 5001.
PORT=5001

# The URL of your frontend application (used for CORS and constructing links)
# Default for Vite React is usually http://localhost:5173
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 🗄️ DATABASE CONFIGURATION
# ------------------------------------------------------------------------------

# Your MongoDB Connection String.
# Create a cluster at https://www.mongodb.com/cloud/atlas and get your URI.
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/your_db_name
# Note: Ensure your current IP address is whitelisted in MongoDB Atlas Network Access.
MONGO_URI=

# ------------------------------------------------------------------------------
# 🔐 AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------

# Secret key used for signing and verifying JWT tokens.
# IN PRODUCTION: Generate a strong random string (e.g., using `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=your-jwt-secret-key-change-this

# How long the JWT token should remain valid. (e.g., 1h, 7d, 30d)
JWT_EXPIRE=7d

# ------------------------------------------------------------------------------
# 📧 EMAIL CONFIGURATION (Nodemailer / SMTP)
# ------------------------------------------------------------------------------

# The email address used to send system emails (e.g., password resets, notifications).
EMAIL_USER=your-email@gmail.com

# The password for the email account.
# IMPORTANT: If using Gmail, you MUST use an "App Password", NOT your regular account password.
# Setup: Manage Google Account -> Security -> 2-Step Verification -> App passwords.
EMAIL_PASS=your-gmail-app-password

# ------------------------------------------------------------------------------
# 🤖 AI & THIRD-PARTY INTEGRATIONS
# ------------------------------------------------------------------------------

# Google Gemini API Key used for AI-powered features.
# You can generate a free API key here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
